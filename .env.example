# The web UI stays local unless you deliberately change this binding.
TASKBOARD_WEB_BIND=127.0.0.1
TASKBOARD_WEB_PORT=3000

# Set this to the Docker host's LAN IP only when trusted LAN clients need MCP.
TASKBOARD_MCP_BIND=127.0.0.1
TASKBOARD_MCP_PORT=3001

# Generate with: openssl rand -base64 48 | tr -d '\n'
# Keep this value out of Git and send it only over a trusted channel.
TASKBOARD_MCP_TOKEN=replace-with-a-random-token-at-least-32-characters-long
