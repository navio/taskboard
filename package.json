{
  "name": "tasks",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "vite dev --port 3000",
    "generate-routes": "vite build",
    "build": "vite build",
    "build:mcp": "esbuild src/mcp.ts --bundle --platform=node --format=esm --packages=external --outfile=dist-mcp/mcp.mjs && esbuild src/mcp-http.ts --bundle --platform=node --format=esm --packages=external --outfile=dist-mcp/mcp-http.mjs && esbuild src/mcp-client.ts --bundle --platform=node --format=esm --packages=external --outfile=dist-mcp/mcp-client.mjs",
    "start": "node .output/server/index.mjs",
    "mcp": "tsx src/mcp.ts",
    "mcp:http": "tsx src/mcp-http.ts",
    "mcp:client": "tsx src/mcp-client.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@tanstack/react-query": "^5.108.2",
    "@tanstack/react-router": "1.170.46",
    "@tanstack/react-start": "1.169.7",
    "better-sqlite3": "^13.2.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.1",
    "esbuild": "^0.28.2",
    "nitro": "npm:nitro-nightly@^3.0.1-20261120-203731-571aade6",
    "tsx": "^4.23.15",
    "typescript": "^6.0.2",
    "vite": "^8.0.0",
    "vitest": "^5.1.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "lightningcss"
    ]
  }
}
